    "onQueryEvent는 event를 그대로",
    "messagesRef와 React state",
    "UI layer가 나머지와 깔끔히"
  ],
  "contentInputs": [
    "content.mjs",
    "content/algorithm-narratives.json",
    "content/source-profile.json",
    "content/publication.json",
    "content/semantic-checks.json",
    "content/theory-categories.json",
    "content/visual-language.json",
    "content/report-quality-rubric.json",
    "content/repository-coverage-rubric.json",
    "content/visual-review-samples.json"
  ]
