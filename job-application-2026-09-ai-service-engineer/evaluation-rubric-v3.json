  "purpose": "롯데이노베이트 AI 서비스 엔지니어 지원 자기소개서 초안의 편집 적합도를 비교하고 90점 이상 세트만 결과물에 남긴다.",
  "definition": {
    "id": "rubric:self-introduction-ai-service-engineer",
    "revision": "v3",
    "constructs": [
      {"id": "human_centered_narrative", "name": "사람 중심 서사와 가치", "weight": 30, "meaning": "사용자·업무 맥락과 지원자의 관점이 기술보다 상위에서 드러나는 정도"},
      {"id": "role_service_fit", "name": "직무·서비스 맥락 적합성", "weight": 25, "meaning": "공고의 AI API·데이터·서비스 운영·검증 업무로 행동을 번역하는 정도"},
      {"id": "evidence_causal_integrity", "name": "근거·인과·추상화 충실도", "weight": 30, "meaning": "프로젝트 사실·개인 기여·판단·학습을 과장 없이 상위 서비스 흐름으로 연결하는 정도"},
      {"id": "communication_defense", "name": "전달·방어 가능성", "weight": 15, "meaning": "문항을 충족하면서 짧고 분명하며 후속 질문에 범위를 설명할 수 있는 정도"}
    ],
    "criteria": [
      {"id": "value_viewpoint_visibility", "domain": "human_centered_narrative", "weight": 12, "question": "지원자의 가치관과 기술에 대한 견해가 경험 나열을 넘어 문장으로 드러나는가?"},
      {"id": "human_context", "domain": "human_centered_narrative", "weight": 8, "question": "사람의 목적·부담·판단·다음 행동이 서비스 설명의 중심에 있는가?"},
      {"id": "narrative_coherence", "domain": "human_centered_narrative", "weight": 6, "question": "Q1 역량·Q2 증거·Q3 가치관이 하나의 인물상으로 이어지는가?"},
      {"id": "modern_ai_paradigm", "domain": "human_centered_narrative", "weight": 4, "question": "AI를 사람을 대체하는 기술이 아니라 책임·검토·피드백이 있는 사회기술적 서비스로 이해하는가?"},
      {"id": "role_fit", "domain": "role_service_fit", "weight": 12, "question": "AI 서비스 API·백엔드·데이터 흐름·플랫폼 고도화·품질 검증과 행동이 연결되는가?"},
      {"id": "business_translation", "domain": "role_service_fit", "weight": 7, "question": "기술 선택이 업무 프로세스와 사업 가치의 변화로 번역되는가?"},
      {"id": "future_contribution", "domain": "role_service_fit", "weight": 6, "question": "입사 후 기여가 추상적인 의지가 아니라 관찰·검증·개선 행동으로 제시되는가?"},
      {"id": "evidence_attribution", "domain": "evidence_causal_integrity", "weight": 10, "question": "공식 사실·저장소 사실·사용자 제공 기여·제한된 해석·미래 계획의 경계가 보이는가?"},
      {"id": "causal_process", "domain": "evidence_causal_integrity", "weight": 10, "question": "문제→판단→수행→검증→학습의 인과가 이어지는가?"},
      {"id": "service_mechanism_abstraction", "domain": "evidence_causal_integrity", "weight": 10, "question": "기술 메커니즘을 구현 단위가 아니라 서비스 목적·책임·근거·사용자 영향의 상위 개념으로 설명하는가?"},
      {"id": "prompt_compliance", "domain": "communication_defense", "weight": 5, "question": "각 문항의 요구 요소와 300~700자 조건을 충족하는가?"},
      {"id": "readability_distinctiveness", "domain": "communication_defense", "weight": 5, "question": "기술 나열 없이 빠르게 읽히며 다른 지원자와 구별되는가?"},
      {"id": "interview_defense", "domain": "communication_defense", "weight": 5, "question": "왜 그렇게 판단했는지, 무엇을 실제로 했는지, 무엇이 아직 미확인인지 답할 수 있는가?"}
    ],
    "commonScale": {
      "measurementLevel": "ordinal",
      "0": "부재·모순·잘못된 귀속",
      "1": "주장 또는 용어는 있으나 맥락과 근거가 없음",
      "2": "한 경험 또는 한 문단에서 부분적으로 확인됨",
      "3": "문제·판단·행동·영향이 인과적으로 연결되고 범위를 방어할 수 있음",
      "4": "상위 맥락의 관점이 일관되고 사용자·서비스 영향과 한계까지 연결됨",
