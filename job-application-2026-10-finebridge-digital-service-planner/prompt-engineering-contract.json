    "dimensions": ["task_success", "instruction_following", "grounding", "semantic_validity", "safety_authority", "privacy", "latency", "token_cost", "tool_efficiency"],
    "nonCompensatoryDimensions": ["grounding", "semantic_validity", "safety_authority", "privacy"],
    "promotionRuleRef": "promotion:none-report-only-runtime-candidate",
    "humanCalibrationRef": "calibration:applicant-confirmation-required"
