  "stopping": {
    "maxToolCalls": 0,
    "maxWaitsPerFingerprint": 1,
    "maxCompactions": 1,
    "maxRevisions": 1,
    "repeatedFingerprintAction": "ask_authorized_owner",
    "terminalEvidenceRefs": ["validation.json", "independent-review.json"],
    "noProgressWindowRef": "stop:unchanged-validation-fingerprint"
